# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration - Generate unique secrets for each
JWT_SECRET=your-otp-jwt-secret-key-here
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret-key-here
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000 # 15 minutes
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-here
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000 # 7 days

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/brand-mate-v1

# CORS Configuration
APP_CORS_ORIGIN=http://localhost:3000

# OTP Configuration
OTP_EXPIRATION_MS=300000 # 5 minutes
OTP_TOOKEN_EXPIRATION_MS=300000 # 5 minutes
COOKIE_EXPIRATION_MS=604800000 # 7 days


